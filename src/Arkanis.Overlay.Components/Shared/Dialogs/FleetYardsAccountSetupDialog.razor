@using Arkanis.Overlay.Common.Extensions
@using Arkanis.Overlay.Common.Models
@using Arkanis.Overlay.Infrastructure.Helpers
@using Arkanis.Overlay.Infrastructure.Services.External
@using FluentResults
@inject FleetYardsAccountContext FleetYardsAccountContext

<!--suppress CssUnusedSymbol, CssUnresolvedCustomProperty -->
<style>
    .fleetyards-account-setup {
    }
</style>

<MudDialog Gutters="false"
           Class="fleetyards-account-setup"
           ContentClass="ma-0"
           ContentStyle="background: var(--mud-palette-background);">
    <TitleContent>
        <FleetYardsLogo
            Style="height: 32px"
            ContentId="@ContentId"/>
    </TitleContent>
    <DialogContent>
        <MudStepper @ref="_stepper">
            <ChildContent>
                <MudStep Title="Sign in">
                    <MudStack Class="py-4"
                              AlignItems="@AlignItems.Center">
                        <MudText>
                            This tutorial will help you connect your
                            <MudLink Href="@ExternalLinkHelper.GetFleetYardsLink(ContentId)" Target="_blank">
                                FleetYards
                            </MudLink>
                            account to the Arkanis Overlay.
                        </MudText>
                        <MudText>
                            FleetYards is a community ship database and hangar tracker for Star Citizen.
                            By connecting your account, the Arkanis Overlay can display your owned ships
                            and fleet information.
                        </MudText>
                        <MudButton EndIcon="@Icons.Material.Filled.ChevronRight"
                                   OnClick="@NextStepAsync">
                            Continue
                        </MudButton>
                    </MudStack>
                </MudStep>
                <MudStep Title="Get access token">
                    <MudStack Class="py-4"
                              AlignItems="@AlignItems.Center">
                        <MudText>
                            Visit your
                            <MudLink Href="@ExternalLinkHelper.GetFleetYardsSettingsLink(ContentId)"
                                     Target="_blank">
                                FleetYards token settings
                            </MudLink>
                            page. Create a new personal access token with the
                            <b>hangar:read</b> and <b>fleet:read</b> scopes.
                        </MudText>
                        <MudText>
                            Once created, copy the access token and proceed to the next step.
                        </MudText>
                        <MudAlert Severity="@Severity.Info">
                            You must be signed in to FleetYards to access the token settings page.
                        </MudAlert>
                        <MudButton EndIcon="@Icons.Material.Filled.ChevronRight"
                                   OnClick="@NextStepAsync">
                            Continue
                        </MudButton>
                    </MudStack>
                </MudStep>
                <MudStep Title="Enter token" HasError="@TokenHasError">
                    <MudStack Class="py-4"
                              AlignItems="@AlignItems.Center">
                        <MudText Align="@Align.Center">
                            Paste your FleetYards access token into the field below.
                        </MudText>
                        <div style="width: 80%">
                            <MudStack Justify="@Justify.Center"
                                      Class="w-100">
                                <MudTextField
                                    Label="Access Token"
                                    @bind-Value="_token"
                                    @bind-Value:after="CheckTokenAsync"
                                    Error="@TokenHasError"
                                    ErrorText="@_tokenError?.Message"
                                    InputType="@InputType.Password"
                                    Disabled="@(_isLoading)"
                                    FullWidth
                                    Immediate
                                    Required/>

                                @if (_isLoading)
                                {
                                    <MudProgressLinear
                                        Indeterminate/>
                                }
                                else if (TokenHasError)
                                {
                                    <MudButton Variant="@Variant.Filled"
                                               OnClick="@CheckTokenAsync"
                                               StartIcon="@Icons.Material.Filled.Refresh">
                                        Retry
                                    </MudButton>
                                }
                            </MudStack>
                        </div>
                    </MudStack>
                </MudStep>
            </ChildContent>
            <CompletedContent>
                <MudAlert Severity="@Severity.Success">
                    <b>Success!</b>
                    Your FleetYards account has been successfully connected to the Arkanis Overlay.
                </MudAlert>
            </CompletedContent>
            <ActionContent>
                @* Navigation is managed by controls within individual steps. *@
            </ActionContent>
        </MudStepper>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@Cancel">Close</MudButton>
    </DialogActions>
</MudDialog>

@code
{
    private const string ContentId = "fleetyards_connect_dialog";

    private MudStepper? _stepper;

    private string? _token;
    private IError? _tokenError;
    private bool _isLoading;

    private bool TokenHasError
        => _tokenError is not null;

    [CascadingParameter]
    public required IMudDialogInstance MudDialog { get; set; }

    private void Cancel()
        => MudDialog.Cancel();

    private async Task NextStepAsync()
        => await _stepper!.NextStepAsync();

    public static async Task<DialogResult> UnlinkAsync(IDialogService dialogService, FleetYardsAccountContext accountContext)
    {
        if (!accountContext.IsAuthenticated)
        {
            return DialogResult.Ok(true);
        }

        var options = new MessageBoxOptions
        {
            Title = $"Unlink {accountContext.Identity.Name} (FleetYards account)",
            Message = "This action cannot be undone. Are you sure?",
            YesText = "Unlink",
            CancelText = "Cancel",
        };
        if (await dialogService.ShowMessageBox(options) is not true)
        {
            return DialogResult.Cancel();
        }

        await accountContext.UnlinkAsync(CancellationToken.None);
        return DialogResult.Ok(true);
    }

    public static async Task<DialogResult> ShowAsync(IDialogService dialogService)
    {
        var dialogOptions = new DialogOptions
        {
            FullWidth = true,
            MaxWidth = MaxWidth.Medium,
            CloseOnEscapeKey = true,
            CloseButton = true,
        };
        var dialogRef = await dialogService.ShowAsync<FleetYardsAccountSetupDialog>(null, dialogOptions);
        return await dialogRef.Result ?? DialogResult.Cancel();
    }

    private async Task CheckTokenAsync()
    {
        _tokenError = _token switch
        {
            null or { Length: 0 } => new Error("Please enter a valid access token."),
            _ => null,
        };
        if (_tokenError is not null || _token is null)
        {
            return;
        }

        _isLoading = true;

        try
        {
            var credentials = new AccountOAuth2Credentials(ExternalService.FleetYards)
            {
                AccessToken = _token,
            };

            var result = await FleetYardsAccountContext.ConfigureAsync(credentials, CancellationToken.None);
            if (FleetYardsAccountContext.IsAuthenticated)
            {
                await _stepper!.NextStepAsync();
            }

            result.MapErrors(error => _tokenError ??= error);
        }
        catch (Exception exception)
        {
            _tokenError = exception.ToError();
        }
        finally
        {
            _isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

}

@using Arkanis.Overlay.External.FleetYards
@using Arkanis.Overlay.Infrastructure.Services.External
@inject IDialogService DialogService
@inject FleetYardsLinkHelper FleetYardsLinkHelper
@inject FleetYardsAccountContext FleetYardsAccountContext


<MudExpansionPanel Class="external-service-config" Disabled="@(!FleetYardsAccountContext.IsAuthenticated)">
    <TitleContent>
        <MudStack AlignItems="@AlignItems.Center"
                  Justify="@Justify.Center"
                  Row>
            <div style="height: 32px; margin-top: -4px;">
                <FleetYardsLogo
                    Style="max-height: 38px;"
                    Class="my-n1"
                    ContentId="@ContentId"/>
            </div>
        </MudStack>
        <MudStack AlignItems="@AlignItems.Center" Row>
            <ExternalAccountStatusBadge
                Model="@FleetYardsAccountContext"/>
            <ExternalAccountDetails
                Model="@FleetYardsAccountContext"/>
            <MudSpacer/>
            <div class="my-n2">
                @if (FleetYardsAccountContext.IsAuthenticated)
                {
                    <MudButton Variant="@Variant.Outlined"
                               Color="@Color.Default"
                               StartIcon="@Icons.Material.Filled.OpenInNew"
                               Href="@FleetYardsLinkHelper.GetLinkAccountUrl()"
                               Target="_blank">
                        Connect different account
                    </MudButton>
                    <MudIconButton
                        Variant="@Variant.Outlined"
                        Color="@Color.Error"
                        Icon="@Icons.Material.Filled.LinkOff"
                        OnClick="@UnlinkAsync"/>
                }
                else
                {
                    <MudButton Variant="@Variant.Outlined"
                               Color="@Color.Info"
                               StartIcon="@Icons.Material.Filled.OpenInNew"
                               Href="@FleetYardsLinkHelper.GetLinkAccountUrl()"
                               Target="_blank">
                        Connect account
                    </MudButton>
                }
            </div>
        </MudStack>
    </TitleContent>
    <ChildContent>
    </ChildContent>
</MudExpansionPanel>

@code
{

    [Parameter]
    public string? ContentId { get; set; }

    public async Task<DialogResult> UnlinkAsync()
    {
        if (!FleetYardsAccountContext.IsAuthenticated)
        {
            return DialogResult.Ok(true);
        }

        var options = new MessageBoxOptions
        {
            Title = $"Unlink {FleetYardsAccountContext.Identity.Name} ({FleetYardsAccountContext.AuthenticatorInfo.DisplayName} account)",
            Message = "This action cannot be undone. Are you sure?",
            YesText = "Unlink",
            CancelText = "Cancel",
        };
        if (await DialogService.ShowMessageBox(options) is not true)
        {
            return DialogResult.Cancel();
        }

        await FleetYardsAccountContext.UnlinkAsync(CancellationToken.None);
        return DialogResult.Ok(true);
    }

}
